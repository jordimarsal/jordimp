---
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Analytics from '../components/Analytics.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Monogram from '../components/Monogram.astro';
import HeaderNav from '../components/HeaderNav.astro';
import LocaleSwitcher from '../components/LocaleSwitcher.astro';
import Footer from '../components/Footer.astro';
import type { BreadcrumbItem } from '../lib/seo';

export interface Props {
  lang: 'en' | 'es' | 'ca';
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  breadcrumbs?: readonly BreadcrumbItem[];
}

const { lang, title, description, path, noindex, breadcrumbs } = Astro.props;
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0b1220" />
    <script is:inline>
      (() => { const s = localStorage.getItem('theme');
        const theme = s ?? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = theme;
        const color = document.querySelector('meta[name="theme-color"]');
        if (color) color.content = theme === 'light' ? '#fafbfd' : '#0b1220'; })();
    </script>
    <SEO {lang} {title} {description} {path} {noindex} {breadcrumbs} />
    <Analytics />
  </head>
  <body>
    <header class="container">
      <a href={`/${lang}/`} aria-label="Home"><slot name="logo"><Monogram /></slot></a>
      <nav><slot name="nav"><HeaderNav {lang} {path} /></slot></nav>
      <slot name="actions"><LocaleSwitcher {lang} {path} /></slot>
      <ThemeToggle {lang} />
    </header>
    <main class="container"><slot /></main>
    <slot name="footer"><Footer {lang} /></slot>
  </body>
</html>
