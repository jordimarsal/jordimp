---
import type { Locale } from '../../lib/i18n';
import { DEPTS, FLOOR_ORDER, PAGES, UI } from '../../data/content';
import type { DeptKey, QualityReport } from '../../data/types';
import { svgEntrance, svgFloor, svgRoof, floorPlateLabel, itePlaqueSvg } from '../../lib/building-svg';
import { plaqueText } from '../../lib/quality';
import { dirRoute, srcPath } from '../../lib/paths';
import DeptPanel from './DeptPanel.astro';

export interface Props {
  lang: Locale;
  report?: QualityReport | null;
}

const { lang, report = null } = Astro.props;

const STREET: Record<Locale, string> = {
  en: 'ONE-WAY STREET — DEPLOYS ONLY',
  es: 'CALLE DE SENTIDO ÚNICO — SOLO DEPLOYS',
  ca: 'CARRER DE SENTIT ÚNIC — NOMÉS DEPLOYS',
};

const floors = FLOOR_ORDER.map((key: DeptKey) => ({ key, dept: DEPTS[key] }));
const plaqueHref = srcPath(lang, dirRoute(PAGES.inspections.route));
---
<div class="sky" id="building">
  <div class="building-scroll">
    <div class="building-stack">
      <Fragment set:html={svgRoof(lang)} />
      {floors.map(({ key, dept }) => (
        <>
          <button class="floor-btn" type="button" id={`dept-${key}`} data-floor={key} aria-expanded="false" aria-controls={`dept-panel-${key}`} aria-label={floorPlateLabel(lang, key)} data-open={`${UI.openPanel[lang].toUpperCase()} ↗`}>
            <Fragment set:html={svgFloor(lang, key)} />
            <span class="icon-hit" aria-hidden="true"></span><span class="floor-bubble" aria-hidden="true">{dept.line[lang]}</span>
          </button>
          <DeptPanel lang={lang} deptKey={key} report={report} />
        </>
      ))}
      <Fragment set:html={svgEntrance(lang)} />
      <a class="ite-plaque" href={plaqueHref} aria-label={plaqueText(lang, report)}>
        <Fragment set:html={itePlaqueSvg()} />
        <span class="ite-plaque__text">{plaqueText(lang, report)}</span>
      </a>
      <div class="street" aria-hidden="true"><span>{STREET[lang]}</span></div>
    </div>
  </div>
</div>
