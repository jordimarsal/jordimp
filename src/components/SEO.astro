---
import { SITE } from '../config';
import { LOCALES } from '../lib/i18n';
import {
  articleJsonLd,
  breadcrumbJsonLd,
  jsonLdScript,
  ogLocale,
  ogLocaleAlternates,
  personJsonLd,
  siteUrl,
  type ArticleInput,
  type BreadcrumbItem,
} from '../lib/seo';

interface Props {
  lang: 'en' | 'es' | 'ca';
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  breadcrumbs?: readonly BreadcrumbItem[];
  ogType?: 'website' | 'article';
  articleSection?: string;
  article?: ArticleInput;
}

const { lang, title, description, path = '', noindex = false, breadcrumbs, ogType = 'website', articleSection, article } = Astro.props;
const demo = import.meta.env.PUBLIC_DEMO === '1';
const canonical = siteUrl(lang, path);
const ogImage = SITE.ogImage;
const alternates = LOCALES.map((locale) => ({ hreflang: locale, href: siteUrl(locale, path) }));
const person = jsonLdScript(personJsonLd(lang));
const breadcrumb =
  breadcrumbs && breadcrumbs.length > 0
    ? jsonLdScript(breadcrumbJsonLd(lang, breadcrumbs))
    : undefined;
const articleLd = article ? jsonLdScript(articleJsonLd(lang, article)) : undefined;
---
<title>{title}</title>
<meta name="description" content={description} />
{(noindex || demo) && <meta name="robots" content="noindex" />}
<link rel="canonical" href={canonical} />
{alternates.map((alternate) => (
  <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
))}
<link rel="alternate" hreflang="x-default" href={siteUrl('en', path)} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={ogType} />
{articleSection && <meta property="article:section" content={articleSection} />}
<meta property="og:site_name" content={SITE.brand} />
<meta property="og:locale" content={ogLocale(lang)} />
{ogLocaleAlternates(lang).map((locale) => (
  <meta property="og:locale:alternate" content={locale} />
))}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Jordimp & Co. — the building. Specs before code." />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<script is:inline type="application/ld+json" set:html={person} />
{breadcrumb && <script is:inline type="application/ld+json" set:html={breadcrumb} />}
{articleLd && <script is:inline type="application/ld+json" set:html={articleLd} />}
