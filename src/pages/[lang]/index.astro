---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Ticker from '../../components/site/Ticker.astro';
import SecHead from '../../components/site/SecHead.astro';
import Building from '../../components/site/Building.astro';
import DeptStrip from '../../components/site/DeptStrip.astro';
import ProjectCard from '../../components/site/ProjectCard.astro';
import { LOCALES, type Locale } from '../../lib/i18n';
import {
  BREADCRUMB_HOME,
  FLOOR_ORDER,
  FEATURED,
  HOME,
  PAGES,
  SITE,
  UI,
  project,
} from '../../data/content';
import qualityJson from '../../data/quality.json';
import { parseQuality } from '../../lib/quality';

export async function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}

type Props = { lang: Locale };
const { lang } = Astro.props;

const quality = parseQuality(qualityJson);
const report = quality.ok ? quality.value : null;

const BUILDING_HEAD: Record<Locale, { title: string; sub: string }> = {
  en: { title: 'The Building', sub: 'FLOORS · 1 PAIR OF HANDS' },
  es: { title: 'El edificio', sub: 'PLANTAS · 1 PAR DE MANOS' },
  ca: { title: 'L’edifici', sub: 'PLANTES · 1 PARELL DE MANS' },
};

const featured = FEATURED.map((slug) => project(slug));
---
<SiteLayout
  lang={lang}
  title={PAGES.home.title[lang]}
  description={PAGES.home.description[lang]}
  path=""
  navKey="home"
  breadcrumbs={[{ name: BREADCRUMB_HOME[lang], path: '' }]}
>
  <main class="wrap" id="main">
    <section class="hero">
      <p class="kicker">{HOME.kicker[lang]}</p>
      <h1 set:html={HOME.h1[lang]} />
      <p class="stand" set:html={HOME.stand[lang]} />
      <div class="meta-row" aria-label={SITE.brand}>
        {HOME.metaChips[lang].map((chip) => <span>{chip}</span>)}
      </div>
      <p class="hint"><span class="arr" aria-hidden="true">&darr;</span> {UI.buildingHint[lang]}</p>
    </section>
    <Ticker lang={lang} />
    <section aria-labelledby="building-title">
      <SecHead
        num="01"
        title={BUILDING_HEAD[lang].title}
        sub={`${FLOOR_ORDER.length} ${BUILDING_HEAD[lang].sub}`}
        id="building-title"
      />
      <Building lang={lang} report={report} />
    </section>
    <section aria-labelledby="featured-title">
      <SecHead
        num={HOME.featuredHead.num}
        title={HOME.featuredHead.title[lang]}
        sub={HOME.featuredHead.sub[lang]}
        id="featured-title"
      />
      <div class="cards">
        {featured.map((p) => (
          <ProjectCard lang={lang} project={p} />
        ))}
      </div>
    </section>
    <section aria-labelledby="depts-title">
      <SecHead
        num={HOME.deptsHead.num}
        title={HOME.deptsHead.title[lang]}
        sub={HOME.deptsHead.sub[lang]}
        id="depts-title"
      />
      <DeptStrip lang={lang} />
    </section>
  </main>
</SiteLayout>
