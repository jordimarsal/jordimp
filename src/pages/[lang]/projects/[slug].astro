---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Breadcrumb from '../../../components/site/Breadcrumb.astro';
import CaseMotif from '../../../components/site/CaseMotif.astro';
import { LOCALES, type Locale } from '../../../lib/i18n';
import {
  BREADCRUMB_DEPTS,
  BREADCRUMB_HOME,
  CASE_BUILD,
  CASE_NOTES,
  CASE_UI,
  DEPTS,
  PAGES,
  PROJECTS,
  project,
  tierProjects,
} from '../../../data/content';
import type { Project } from '../../../data/types';
import { dirRoute, srcPath } from '../../../lib/paths';
import { externalLinkAttrs } from '../../../lib/links';
import { SITE } from '../../../config';

export async function getStaticPaths() {
  return LOCALES.flatMap((lang) =>
    PROJECTS.map((p) => ({ params: { lang, slug: p.slug }, props: { lang, p } })),
  );
}

type Props = { lang: Locale; p: Project };
const { lang, p } = Astro.props;

const d = DEPTS[p.dept];
const route = dirRoute(PAGES[`project-${p.slug}`].route);
const deptRoute = dirRoute(PAGES[d.page].route);
const floorLabel = `DEPT·${d.code} — ${d.name[lang].toUpperCase()}`;
const build = (CASE_BUILD[p.slug] ?? p.highlights)[lang];
const buildSteps = build.map((text, i) => ({ n: String(i + 1).padStart(2, '0'), text }));
const backLabel = CASE_UI.backDept[lang].replace('{dept}', d.name[lang]);
const list = tierProjects(p.tier).map((c) => c.slug);
const idx = list.indexOf(p.slug);
const prev = project(list[(idx - 1 + list.length) % list.length]);
const next = project(list[(idx + 1) % list.length]);
const repoAttrs = externalLinkAttrs(p.github, SITE.url);
const trail = [
  { name: BREADCRUMB_HOME[lang], path: '' },
  { name: BREADCRUMB_DEPTS[lang], path: '#building' },
  { name: d.name[lang], path: deptRoute },
  { name: p.name, path: route },
] as const;
---
<SiteLayout
  lang={lang}
  title={PAGES[`project-${p.slug}`].title[lang]}
  description={PAGES[`project-${p.slug}`].description[lang]}
  path={route}
  navKey="departments"
  breadcrumbs={trail.slice(1)}
  ogType="article"
  articleSection={d.name[lang]}
>
  <main class="wrap" id="main">
    <Breadcrumb lang={lang} {trail} />
    <section class="case-hero">
      <div class="case-hero__body">
        <p class="case-hero__floor mono"><span>{floorLabel}</span><span class="case-hero__year">{p.year}</span></p>
        <h1 id="page-title">{p.name}</h1>
        <p class="stand">{p.summary[lang]}</p>
      </div>
      <CaseMotif slug={p.slug} />
    </section>
    <section class="section" aria-labelledby="cs-brief">
      <h2 id="cs-brief" class="section-title">{CASE_UI.brief[lang]}</h2>
      <p class="prose case-brief">{p.problem[lang]}</p>
    </section>
    <section class="section" aria-labelledby="cs-built">
      <h2 id="cs-built" class="section-title">{CASE_UI.built[lang]}</h2>
      <ol class="buildlog">
        {buildSteps.map((step) => (
          <li><span class="n" aria-hidden="true">{step.n}</span><p>{step.text}</p></li>
        ))}
      </ol>
    </section>
    {p.metrics.length > 0 ? (
      <section class="section" aria-labelledby="cs-metrics">
        <h2 id="cs-metrics" class="section-title">{CASE_UI.metrics[lang]}</h2>
        <div class="stats">
          {p.metrics.map((m) => (
            <div class="stat"><b>{m.value}</b><span>{m.label[lang]}</span></div>
          ))}
        </div>
      </section>
    ) : (
      <section class="section" aria-labelledby="cs-notes">
        <h2 id="cs-notes" class="section-title">{CASE_UI.fieldNotes[lang]}</h2>
        <ul class="fieldnotes">
          {CASE_NOTES[p.slug][lang].map((note) => (
            <li><span class="fn-k">{note.k}</span><p>{note.v}</p></li>
          ))}
        </ul>
      </section>
    )}
    <section class="section" aria-labelledby="cs-stack">
      <h2 id="cs-stack" class="case-label">{CASE_UI.stack[lang]}</h2>
      <div class="chiprow">
        {p.stack.map((s) => <span class="chip3">{s}</span>)}
      </div>
    </section>
    <div class="case-cta">
      {p.github ? (
        <a class="btn btn--big btn--y" href={p.github} {...repoAttrs}>
          <span class="btn__label">{CASE_UI.visitRepo[lang]}</span><span aria-hidden="true">&#8599;</span>
        </a>
      ) : (
        <p class="case-onrequest">{CASE_UI.onRequest[lang]}</p>
      )}
    </div>
    <nav class="pager" aria-label={CASE_UI.pagerLabel[lang]}>
      <a class="pager__link" href={srcPath(lang, `projects/${prev.slug}/`)}>
        <span class="pager__k">{CASE_UI.prev[lang]}</span><span class="pager__name">{prev.name}</span>
      </a>
      <a class="pager__link pager__link--end" href={srcPath(lang, `projects/${next.slug}/`)}>
        <span class="pager__k">{CASE_UI.next[lang]}</span><span class="pager__name">{next.name}</span>
      </a>
    </nav>
    <p class="pager-back">
      <a class="case" href={srcPath(lang, deptRoute)}>{backLabel} <span aria-hidden="true">&uarr;</span></a>
    </p>
  </main>
</SiteLayout>
