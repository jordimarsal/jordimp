---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Breadcrumb from '../../../components/site/Breadcrumb.astro';
import SecHead from '../../../components/site/SecHead.astro';
import ProjectCard from '../../../components/site/ProjectCard.astro';
import { LOCALES, type Locale } from '../../../lib/i18n';
import { BREADCRUMB_HOME, PAGES, PROJECTS, WORK } from '../../../data/content';
import { dirRoute } from '../../../lib/paths';

export async function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}

type Props = { lang: Locale };
const { lang } = Astro.props;

const route = dirRoute(PAGES.work.route);
const stacks = [...new Set(PROJECTS.flatMap((p) => p.stack))].sort((a, b) => a.localeCompare(b));
const filterSummary = WORK.filterSummary[lang].replace('{n}', String(stacks.length));
const trail = [
  { name: BREADCRUMB_HOME[lang], path: '' },
  { name: WORK.head.title[lang] },
] as const;
---
<SiteLayout
  lang={lang}
  title={PAGES.work.title[lang]}
  description={PAGES.work.description[lang]}
  path={route}
  navKey="work"
  breadcrumbs={[{ name: WORK.head.title[lang], path: route }]}
>
  <main class="wrap" id="main">
    <Breadcrumb lang={lang} {trail} />
    <SecHead num={WORK.head.num} title={WORK.head.title[lang]} sub={WORK.head.sub[lang]} id="page-title" asH1 />
    <p class="prose">{WORK.intro[lang]}</p>
    <details class="filter-wrap" data-filter-wrap>
      <summary>{filterSummary}</summary>
      <div class="filter-chips" role="group" aria-label={filterSummary}>
        <button type="button" data-reset aria-pressed="true">{WORK.filterAll[lang]}</button>
        {stacks.map((s) => (
          <button type="button" data-stack={s} aria-pressed="false">{s}</button>
        ))}
      </div>
    </details>
    <p
      class="filter-status"
      id="filter-status"
      role="status"
      aria-live="polite"
      data-count-label={WORK.countLabel[lang]}
      data-one-label={WORK.countOne[lang]}
      data-empty-label={WORK.emptyLabel[lang]}
      set:html={WORK.countLabel[lang].replace('{n}', String(PROJECTS.length))}
    />
    <section class="cards">
      {PROJECTS.map((p) => (
        <ProjectCard lang={lang} project={p} stackAttr={p.stack.join('|')} />
      ))}
    </section>
  </main>
</SiteLayout>
