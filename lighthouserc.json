{
  "comment": "performance floor 0.90 (AMENDED 2026-09-17, Finding F-B: GitHub-hosted 2-core CI runners score /en/ 0.85-0.90 vs local 0.98 on identical builds); accessibility/best-practices/seo stay 0.95",
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:4321/en/",
        "http://localhost:4321/es/",
        "http://localhost:4321/ca/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    }
  }
}
