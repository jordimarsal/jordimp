# ask-api deploy env — copy to .env and fill in. .env is gitignored.
# (Calibrated ask-api tuning lives in docker-compose.yml: threshold 0.60,
# nomic task prefixes search_query:/search_document:.)

# Home of the llama.cpp GGUF models on the host (read-only mount).
LLAMA_MODELS_DIR=/home/jordi/ia/llama/models

# Model filenames inside LLAMA_MODELS_DIR.
EMBED_MODEL_FILE=nomic-embed-text-v1.5.Q4_K_M.gguf
GEN_MODEL_FILE=Qwen3-4B-Instruct-2507-Q4_K_M.gguf

# Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels -> jordimp-homelab).
TUNNEL_TOKEN=change-me
